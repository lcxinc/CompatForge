+static void d3d11_signature_release(struct d3d11_signature *signature)
+{
+    UINT i;
+
+    for (i = 0; i < signature->count; ++i)
+    {
+        free(signature->parameters[i].name);
+        free(signature->parameters[i].semantic_name);
+    }
+    free(signature->parameters);
