+static HRESULT shared_visual_target_publish_surface( struct shared_visual_target *target,
+        void *key, IDXGISurface *surface )
+{
+    struct shared_visual_surface *layer, *candidate;
+    BOOL first_external_surface;
+    HRESULT hr;
+
+    layer = NULL;
+    LIST_FOR_EACH_ENTRY( candidate, &target->external_surfaces,
+            struct shared_visual_surface, entry )
+    {
+        if (candidate->key == key)
+        {
+            layer = candidate;
+            break;
+        }
+    }
+
+    if (!layer)
+    {
+        if (!(layer = calloc(1, sizeof(*layer))))
+            return E_OUTOFMEMORY;
+        layer->key = key;
+        if (FAILED(hr = IDCompositionDevice_CreateVisual( target->dcomp_device,
+                &layer->visual )))
+        {
+            free( layer );
+            return hr;
+        }
+        if (FAILED(hr = IDCompositionVisual_AddVisual( target->dcomp_visual,
+                layer->visual, FALSE, NULL )))
+        {
+            IDCompositionVisual_Release( layer->visual );
+            free( layer );
+            return hr;
+        }
+        list_add_tail( &target->external_surfaces, &layer->entry );
+        TRACE( "created external D2D layer %p for target key %p.\n",
+                layer->visual, key );
+    }
+
+    first_external_surface = !InterlockedCompareExchange( &target->external_surface_published,
+            1, 0 );
+    if (FAILED(hr = IDCompositionVisual_SetContent( layer->visual, (IUnknown *)surface )))
+    {
+        if (first_external_surface)
+            InterlockedExchange( &target->external_surface_published, 0 );
+        return hr;
+    }
+    if (first_external_surface)
+    {
+        /* The root initially owns a transparent placeholder surface used by
+         * the software bridge. Remove it once the first native D2D layer is
+         * ready, otherwise it can obscure the layers during composition. */
+        IDCompositionVisual_SetContent( target->dcomp_visual, NULL );
+    }
+    return S_OK;
+}
