+HRESULT WINAPI wine_windows_ui_publish_d2d_surface( IDXGISurface *surface, void *key )
+{
+    struct shared_visual_target *target, *candidate;
+    IDXGISurface *published_surface = NULL;
+    DXGI_SURFACE_DESC desc;
+    DWORD thread_id;
+    HRESULT hr;
+
+    if (!surface)
+        return E_INVALIDARG;
+    if (FAILED(hr = IDXGISurface_GetDesc(surface, &desc)))
+        return hr;
+    if (desc.Width < 300 || desc.Height < 100)
+        return S_FALSE;
+
+    thread_id = GetCurrentThreadId();
+    target = NULL;
+    EnterCriticalSection( &shared_targets_cs );
+    LIST_FOR_EACH_ENTRY(candidate, &shared_targets, struct shared_visual_target, entry)
+    {
+        if (candidate->render_thread_id != thread_id || !candidate->root || !candidate->dcomp_visual)
+            continue;
+        InterlockedIncrement( &candidate->ref );
+        target = candidate;
+        break;
+    }
+    LeaveCriticalSection( &shared_targets_cs );
+
+    if (!target)
+        return S_FALSE;
+
+    TRACE( "publishing D2D surface %p (%ux%u) to shared target %p.\n",
+            surface, desc.Width, desc.Height, target );
+    if (SUCCEEDED( hr = wine_windows_ui_snapshot_d2d_surface( surface, &published_surface )))
+        surface = published_surface;
+    else
+        TRACE( "D2D surface snapshot failed, hr %#lx; using source surface.\n", hr );
+    hr = shared_visual_target_publish_surface( target, key, surface );
+    if (SUCCEEDED(hr))
+        hr = IDCompositionDevice_Commit( target->dcomp_device );
+    if (SUCCEEDED(hr) && target->host_window)
+        hr = wine_dcomp_commit_window( target->host_window );
+    if (published_surface)
+        IDXGISurface_Release( published_surface );
+    visual_target_partner_Release( &target->IVisualTargetPartner_iface );
+    return hr;
+}
