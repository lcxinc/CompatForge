+static void test_effect_source_parameter(void)
+{
+    static const WCHAR class_name[] = L"Windows.UI.Composition.CompositionEffectSourceParameter";
+    static const WCHAR parameter_name[] = L"ColorSource";
+    IActivationFactory *factory = NULL;
+    ICompositionEffectSourceParameterFactory *source_factory = NULL;
+    ICompositionEffectSourceParameter *parameter = NULL;
+    IGraphicsEffectSource *graphics_source = NULL;
+    HSTRING class_string = NULL, name = NULL, returned_name = NULL, runtime_name = NULL;
+    const WCHAR *buffer;
+    HRESULT hr;
+
+    hr = WindowsCreateString( class_name, ARRAY_SIZE( class_name ) - 1, &class_string );
+    ok( hr == S_OK, "WindowsCreateString failed, hr %#lx.\n", hr );
+    if (FAILED( hr )) return;
+    hr = RoGetActivationFactory( class_string, &IID_IActivationFactory, (void **)&factory );
+    ok( hr == S_OK || broken( hr == REGDB_E_CLASSNOTREG ),
+            "RoGetActivationFactory failed, hr %#lx.\n", hr );
+    if (FAILED( hr ))
+    {
+        win_skip( "%s runtimeclass not registered.\n", wine_dbgstr_w( class_name ) );
+        WindowsDeleteString( class_string );
+        return;
+    }
+
+    check_interface( factory, &IID_IActivationFactory, TRUE );
+    hr = IActivationFactory_QueryInterface( factory, &IID_ICompositionEffectSourceParameterFactory,
+            (void **)&source_factory );
+    ok( hr == S_OK, "QueryInterface(ICompositionEffectSourceParameterFactory) failed, hr %#lx.\n", hr );
+    if (FAILED( hr ))
+    {
+        IActivationFactory_Release( factory );
+        WindowsDeleteString( class_string );
+        return;
+    }
+
+    hr = WindowsCreateString( parameter_name, ARRAY_SIZE( parameter_name ) - 1, &name );
+    ok( hr == S_OK, "WindowsCreateString failed, hr %#lx.\n", hr );
+    if (FAILED( hr ))
+    {
+        ICompositionEffectSourceParameterFactory_Release( source_factory );
+        IActivationFactory_Release( factory );
+        WindowsDeleteString( class_string );
+        return;
+    }
+
+    hr = ICompositionEffectSourceParameterFactory_Create( source_factory, name, &parameter );
+    ok( hr == S_OK, "Create failed, hr %#lx.\n", hr );
+    ok( parameter != NULL, "Expected an effect source parameter.\n" );
+    if (parameter)
+    {
+        check_interface( parameter, &IID_ICompositionEffectSourceParameter, TRUE );
+        check_interface( parameter, &IID_IGraphicsEffectSource, TRUE );
+        hr = ICompositionEffectSourceParameter_get_Name( parameter, &returned_name );
+        ok( hr == S_OK, "get_Name failed, hr %#lx.\n", hr );
+        if (SUCCEEDED( hr ) && returned_name)
+        {
+            buffer = WindowsGetStringRawBuffer( returned_name, NULL );
+            ok( !wcscmp( buffer, parameter_name ), "Expected name %s, got %s.\n",
+                    wine_dbgstr_w( parameter_name ), wine_dbgstr_w( buffer ) );
+        }
+        else if (SUCCEEDED( hr ))
+            ok( 0, "get_Name returned a null HSTRING.\n" );
+        WindowsDeleteString( returned_name );
+        hr = ICompositionEffectSourceParameter_GetRuntimeClassName( parameter, &runtime_name );
+        ok( hr == S_OK, "GetRuntimeClassName failed, hr %#lx.\n", hr );
+        if (SUCCEEDED( hr ) && runtime_name)
+        {
+            buffer = WindowsGetStringRawBuffer( runtime_name, NULL );
+            ok( !wcscmp( buffer, class_name ), "Got runtime class %s.\n", wine_dbgstr_w( buffer ) );
+        }
+        else if (SUCCEEDED( hr ))
+            ok( 0, "GetRuntimeClassName returned a null HSTRING.\n" );
+        WindowsDeleteString( runtime_name );
+        hr = ICompositionEffectSourceParameter_QueryInterface( parameter, &IID_IGraphicsEffectSource,
+                (void **)&graphics_source );
+        ok( hr == S_OK, "QueryInterface(IGraphicsEffectSource) failed, hr %#lx.\n", hr );
+        if (SUCCEEDED( hr )) IGraphicsEffectSource_Release( graphics_source );
+        ICompositionEffectSourceParameter_Release( parameter );
+    }
+    WindowsDeleteString( name );
+    ICompositionEffectSourceParameterFactory_Release( source_factory );
+    IActivationFactory_Release( factory );
+    WindowsDeleteString( class_string );
+}
