+/*
+ * WinUI 3 uses this API as a display-independent heartbeat for its composition
+ * loop.  Wine does not currently expose a host compositor clock, so use the
+ * same refresh-independent 60 Hz cadence as the composition worker while
+ * still honoring application events and the caller's timeout.
+ */
+DWORD WINAPI DCompositionWaitForCompositorClock(UINT count, const HANDLE *handles, DWORD timeout)
+{
+    const DWORD frame_timeout = 16;
+    DWORD wait_timeout, wait_result;
+
+    TRACE("count %u, handles %p, timeout %lu.\n", count, handles, timeout);
+
+    if (count && !handles)
+        return STATUS_INVALID_PARAMETER;
+
+    /* The caller's handles are additional wake sources. Preserve their
+     * normal wait semantics and reserve the next result value for the clock
+     * tick, as on Windows (WAIT_OBJECT_0 + count). */
+    wait_timeout = timeout == INFINITE ? frame_timeout : min(timeout, frame_timeout);
+    if (count)
+    {
+        wait_result = WaitForMultipleObjects(count, handles, FALSE, wait_timeout);
+        if (wait_result < WAIT_OBJECT_0 + count)
+            return wait_result;
+        if (wait_result >= WAIT_ABANDONED_0 && wait_result < WAIT_ABANDONED_0 + count)
+            return wait_result;
+        if (wait_result == WAIT_FAILED)
+            return STATUS_INVALID_HANDLE;
+    }
+    else
+    {
+        Sleep(wait_timeout);
+        wait_result = WAIT_TIMEOUT;
+    }
+
+    if (wait_result != WAIT_TIMEOUT)
+        return STATUS_INVALID_PARAMETER;
+    if (timeout != INFINITE && timeout < frame_timeout)
+        return STATUS_TIMEOUT;
+    return WAIT_OBJECT_0 + count;
