+static BOOL d3d11_make_shader_executable(const struct d3d11_function_linking_graph *graph,
+        const void *shader_data, SIZE_T shader_size, const char *target_name,
+        struct vkd3d_shader_code *output)
+{
+    struct vkd3d_shader_code input = {shader_data, shader_size};
+    struct vkd3d_shader_dxbc_desc desc;
+    struct vkd3d_shader_dxbc_section_desc *sections = NULL;
+    BYTE **section_data = NULL;
+    BYTE *input_signature = NULL, *output_signature = NULL;
+    SIZE_T input_signature_size = 0, output_signature_size = 0;
+    SIZE_T section_count, section_index;
+    DWORD shader_type;
+    SIZE_T i;
+    int ret = -1;
+    BOOL shader_found = FALSE;
+
+    output->code = NULL;
+    output->size = 0;
+
+    if (!graph)
+        return FALSE;
+    if (target_name[0] == 'p')
+        shader_type = 0x0000;
+    else if (target_name[0] == 'v')
+        shader_type = 0x0001;
+    else if (target_name[0] == 'g')
+        shader_type = 0x0002;
+    else
+        return FALSE;
+
+    if (vkd3d_shader_parse_dxbc(&input, 0, &desc, NULL) < 0)
+        return FALSE;
+
+    if (!(section_data = calloc(desc.section_count ? desc.section_count : 1, sizeof(*section_data))))
+        goto done;
+    if (FAILED(d3d11_build_signature_chunk(graph, TRUE, &input_signature, &input_signature_size))
+            || FAILED(d3d11_build_signature_chunk(graph, FALSE, &output_signature, &output_signature_size)))
+        goto done;
+
+    for (i = 0; i < desc.section_count; ++i)
+    {
+        DWORD version;
+
+        if (desc.sections[i].tag != 0x52444853 /* SHDR */
+                && desc.sections[i].tag != 0x58454853 /* SHEX */)
+            continue;
+        if (desc.sections[i].data.size < sizeof(version))
+            goto done;
+        if (!(section_data[i] = malloc(desc.sections[i].data.size)))
+            goto done;
+        memcpy(section_data[i], desc.sections[i].data.code, desc.sections[i].data.size);
+        memcpy(&version, section_data[i], sizeof(version));
+        if ((version >> 16) == 0xfff0)
+        {
+            version = (shader_type << 16) | (version & 0xffff);
+            memcpy(section_data[i], &version, sizeof(version));
+        }
+        shader_found = TRUE;
+        break;
+    }
+
+    if (!shader_found)
+        goto done;
+    section_count = desc.section_count + !!input_signature + !!output_signature;
+    if (!(sections = calloc(section_count, sizeof(*sections))))
+        goto done;
+
+    section_index = 0;
+    if (input_signature)
+    {
+        sections[section_index].tag = TAG_ISGN;
+        sections[section_index].data.code = input_signature;
+        sections[section_index++].data.size = input_signature_size;
+    }
+    if (output_signature)
+    {
+        sections[section_index].tag = TAG_OSGN;
+        sections[section_index].data.code = output_signature;
+        sections[section_index++].data.size = output_signature_size;
+    }
+    for (i = 0; i < desc.section_count; ++i)
+    {
+        sections[section_index] = desc.sections[i];
+        if (section_data[i])
+            sections[section_index].data.code = section_data[i];
+        ++section_index;
+    }
+    ret = vkd3d_shader_serialize_dxbc(section_count, sections, output, NULL);
+
+done:
+    if (section_data)
+    {
+        for (i = 0; i < desc.section_count; ++i)
+            free(section_data[i]);
+    }
+    free(section_data);
+    free(sections);
+    free(input_signature);
+    free(output_signature);
+    vkd3d_shader_free_dxbc(&desc);
+    return ret == VKD3D_OK;
+}
