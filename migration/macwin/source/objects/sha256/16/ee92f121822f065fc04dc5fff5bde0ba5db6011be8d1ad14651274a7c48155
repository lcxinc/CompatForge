+static HRESULT d3d11_signature_copy(struct d3d11_signature *signature,
+        const D3D11_PARAMETER_DESC *parameters, UINT count)
+{
+    struct d3d11_parameter_desc *copy;
+    UINT i;
+
+    d3d11_signature_release(signature);
+    if (!count)
+        return S_OK;
+    if (!(copy = calloc(count, sizeof(*copy))))
+        return E_OUTOFMEMORY;
+
+    for (i = 0; i < count; ++i)
+    {
+        copy[i].desc = parameters[i];
+        if (parameters[i].Name && !(copy[i].name = d3d11_strdup(parameters[i].Name)))
+            goto out_of_memory;
+        if (parameters[i].SemanticName && !(copy[i].semantic_name = d3d11_strdup(parameters[i].SemanticName)))
+            goto out_of_memory;
+        copy[i].desc.Name = copy[i].name;
+        copy[i].desc.SemanticName = copy[i].semantic_name;
+    }
+
+    signature->parameters = copy;
+    signature->count = count;
+    return S_OK;
+
+out_of_memory:
+    for (i = 0; i < count; ++i)
+    {
+        free(copy[i].name);
+        free(copy[i].semantic_name);
+    }
+    free(copy);
+    return E_OUTOFMEMORY;
