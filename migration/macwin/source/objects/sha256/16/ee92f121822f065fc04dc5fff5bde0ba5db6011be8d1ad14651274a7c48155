+static HRESULT wine_windows_ui_snapshot_d2d_surface( IDXGISurface *source, IDXGISurface **snapshot )
+{
+    D3D11_TEXTURE2D_DESC desc;
+    ID3D11DeviceContext *context = NULL;
+    ID3D11Texture2D *source_texture = NULL, *snapshot_texture = NULL;
+    ID3D11Device *device = NULL;
+    HRESULT hr;
+
+    *snapshot = NULL;
+    if (FAILED( hr = IDXGISurface_QueryInterface( source, &IID_ID3D11Texture2D,
+            (void **)&source_texture )))
+        return hr;
+    if (FAILED( hr = IDXGISurface_GetDevice( source, &IID_ID3D11Device, (void **)&device )))
+        goto done;
+
+    ID3D11Texture2D_GetDesc( source_texture, &desc );
+    desc.Usage = D3D11_USAGE_DEFAULT;
+    desc.BindFlags = D3D11_BIND_RENDER_TARGET;
+    desc.CPUAccessFlags = 0;
+    desc.MiscFlags = D3D11_RESOURCE_MISC_GUARDED;
+    if (desc.Format == DXGI_FORMAT_B8G8R8A8_UNORM)
+        desc.MiscFlags |= D3D11_RESOURCE_MISC_GDI_COMPATIBLE;
+
+    if (FAILED( hr = ID3D11Device_CreateTexture2D( device, &desc, NULL, &snapshot_texture )))
+        goto done;
+    ID3D11Device_GetImmediateContext( device, &context );
+    if (!context)
+    {
+        hr = E_FAIL;
+        goto done;
+    }
+    ID3D11DeviceContext_CopyResource( context, (ID3D11Resource *)snapshot_texture,
+            (ID3D11Resource *)source_texture );
+    ID3D11DeviceContext_Flush( context );
+    hr = ID3D11Texture2D_QueryInterface( snapshot_texture, &IID_IDXGISurface,
+            (void **)snapshot );
+
+done:
+    if (context) ID3D11DeviceContext_Release( context );
+    if (snapshot_texture) ID3D11Texture2D_Release( snapshot_texture );
+    if (device) ID3D11Device_Release( device );
+    if (source_texture) ID3D11Texture2D_Release( source_texture );
+    if (FAILED( hr )) *snapshot = NULL;
+    return hr;
+}
