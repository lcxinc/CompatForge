+static HRESULT d3d11_build_signature_chunk(const struct d3d11_function_linking_graph *graph, BOOL input,
+        BYTE **chunk_data, SIZE_T *chunk_size)
+{
+    const struct d3d11_signature *signature = input ? &graph->input_signature : &graph->output_signature;
+    D3D11_PARAMETER_DESC fallback_desc = {0};
+    const D3D11_PARAMETER_DESC **selected;
+    char **semantic_names;
+    UINT count = input ? graph->function_input_count : signature->count;
+    SIZE_T size, string_offset;
+    UINT i;
+    BYTE *data;
+
+    *chunk_data = NULL;
+    *chunk_size = 0;
+    if (!count)
+        return S_OK;
+
+    fallback_desc.SemanticName = "TEXCOORD0";
+    fallback_desc.Type = D3D_SVT_FLOAT;
+    fallback_desc.Columns = 4;
+    if (!(selected = calloc(count, sizeof(*selected)))
+            || !(semantic_names = calloc(count, sizeof(*semantic_names))))
+    {
+        free(selected);
+        free(semantic_names);
+        return E_OUTOFMEMORY;
+    }
+
+    size = 8 + (SIZE_T)count * 6 * sizeof(DWORD);
+    for (i = 0; i < count; ++i)
+    {
+        INT signature_index = input ? graph->function_input_map[i] : i;
+        const struct d3d11_parameter_desc *parameter = NULL;
+        const char *semantic;
+        char *end;
+
+        if (signature_index >= 0 && signature_index < (INT)signature->count)
+            parameter = &signature->parameters[signature_index];
+        selected[i] = parameter ? &parameter->desc : &fallback_desc;
+        semantic = selected[i]->SemanticName ? selected[i]->SemanticName : "TEXCOORD0";
+        if (!(semantic_names[i] = d3d11_strdup(semantic)))
+        {
+            for (i = 0; i < count; ++i)
+                free(semantic_names[i]);
+            free(selected);
+            free(semantic_names);
+            return E_OUTOFMEMORY;
+        }
+        end = semantic_names[i] + strlen(semantic_names[i]);
+        while (end > semantic_names[i] && end[-1] >= '0' && end[-1] <= '9')
+            --end;
+        *end = 0;
+        size += strlen(semantic_names[i]) + 1;
+    }
+
+    if (!(data = calloc(1, size)))
+    {
+        for (i = 0; i < count; ++i)
+            free(semantic_names[i]);
+        free(selected);
+        free(semantic_names);
+        return E_OUTOFMEMORY;
+    }
+
+    d3d11_write_u32(data, 0, count);
+    d3d11_write_u32(data, sizeof(DWORD), 8);
+    string_offset = 8 + (SIZE_T)count * 6 * sizeof(DWORD);
+    for (i = 0; i < count; ++i)
+    {
+        const D3D11_PARAMETER_DESC *desc = selected[i];
+        SIZE_T record_offset = 8 + (SIZE_T)i * 6 * sizeof(DWORD);
+        const char *semantic = desc->SemanticName ? desc->SemanticName : "TEXCOORD0";
+        const char *end = semantic + strlen(semantic);
+        DWORD semantic_index = 0;
+        DWORD sysval = 0;
+
+        while (end > semantic && end[-1] >= '0' && end[-1] <= '9')
+            --end;
+        if (*end)
+        {
+            const char *digit = end;
+            while (*digit >= '0' && *digit <= '9')
+                semantic_index = semantic_index * 10 + (*digit++ - '0');
+        }
+        if (!strnicmp(semantic, "SV_POSITION", end - semantic)
+                && end - semantic == strlen("SV_POSITION"))
+            sysval = 1;
+        else if (!strnicmp(semantic, "SV_TARGET", end - semantic)
+                && end - semantic == strlen("SV_TARGET"))
+            sysval = 64;
+
+        d3d11_write_u32(data, record_offset, string_offset);
+        d3d11_write_u32(data, record_offset + sizeof(DWORD), semantic_index);
+        d3d11_write_u32(data, record_offset + 2 * sizeof(DWORD), sysval);
+        d3d11_write_u32(data, record_offset + 3 * sizeof(DWORD),
+                d3d11_signature_component_type(desc->Type));
+        d3d11_write_u32(data, record_offset + 4 * sizeof(DWORD), i);
+        d3d11_write_u32(data, record_offset + 5 * sizeof(DWORD), d3d11_signature_mask(desc));
+        memcpy(data + string_offset, semantic_names[i], strlen(semantic_names[i]) + 1);
+        string_offset += strlen(semantic_names[i]) + 1;
+    }
+
+    for (i = 0; i < count; ++i)
+        free(semantic_names[i]);
+    free(selected);
+    free(semantic_names);
+    *chunk_data = data;
+    *chunk_size = size;
+    return S_OK;
+}
