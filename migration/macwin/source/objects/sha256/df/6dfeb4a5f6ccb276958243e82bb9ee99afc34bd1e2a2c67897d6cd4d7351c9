+        source = (IWICBitmapSource *)scaler;
+    }
+    if (transform_impl->bounds.Width && transform_impl->bounds.Height)
+    {
+        rect.X = transform_impl->bounds.X;
+        rect.Y = transform_impl->bounds.Y;
+        rect.Width = transform_impl->bounds.Width;
+        rect.Height = transform_impl->bounds.Height;
+        if (FAILED(hr = IWICImagingFactory_CreateBitmapClipper(factory, &clipper))) goto done;
+        if (FAILED(hr = IWICBitmapClipper_Initialize(clipper, source, &rect))) goto done;
+        source = (IWICBitmapSource *)clipper;
+        width = rect.Width;
+        height = rect.Height;
+    }
