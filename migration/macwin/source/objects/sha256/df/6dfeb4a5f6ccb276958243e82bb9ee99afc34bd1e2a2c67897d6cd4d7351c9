+            IsEqualGUID(iid, &IID_IActivationFactory)) *out = &impl->IActivationFactory_iface;
+    else if (impl->kind == FACTORY_DECODER && IsEqualGUID(iid, &IID_IBitmapDecoderStatics))
+        *out = &impl->IBitmapDecoderStatics_iface;
+    else if (impl->kind == FACTORY_ENCODER && IsEqualGUID(iid, &IID_IBitmapEncoderStatics))
+        *out = &impl->IBitmapEncoderStatics_iface;
+    if (!*out) return E_NOINTERFACE;
+    return S_OK;
