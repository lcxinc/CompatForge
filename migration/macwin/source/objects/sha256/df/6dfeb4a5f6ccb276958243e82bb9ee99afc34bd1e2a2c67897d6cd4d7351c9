+        if (status != Started) break;
+        Sleep(1);
+    } while (++elapsed < 30000);
+
+    if (SUCCEEDED(hr) && status == Error)
+    {
+        if (SUCCEEDED(IAsyncInfo_get_ErrorCode(info, &error))) hr = error;
+        else hr = E_FAIL;
+    }
+    else if (SUCCEEDED(hr) && status == Canceled) hr = E_ABORT;
+    else if (SUCCEEDED(hr) && status == Started) hr = HRESULT_FROM_WIN32(ERROR_TIMEOUT);
+    IAsyncInfo_Release(info);
+    return hr;
+}
