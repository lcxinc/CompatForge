+    IBitmapEncoder *encoder = NULL;
+    const GUID *codec_id;
+    HRESULT hr, create_hr;
+    if (!decoder || !stream) return E_INVALIDARG;
+    if (decoder->lpVtbl != &decoder_vtbl) return E_NOINTERFACE;
+    decoder_impl = impl_from_IBitmapDecoder(decoder);
+    codec_id = IsEqualGUID(&decoder_impl->container, &GUID_ContainerFormatPng) ?
+            &CLSID_WICPngEncoder : IsEqualGUID(&decoder_impl->container, &GUID_ContainerFormatJpeg) ?
+            &CLSID_WICJpegEncoder : IsEqualGUID(&decoder_impl->container, &GUID_ContainerFormatBmp) ?
+            &CLSID_WICBmpEncoder : IsEqualGUID(&decoder_impl->container, &GUID_ContainerFormatTiff) ?
+            &CLSID_WICTiffEncoder : IsEqualGUID(&decoder_impl->container, &GUID_ContainerFormatGif) ?
+            &CLSID_WICGifEncoder : &CLSID_WICWmpEncoder;
+    hr = bitmap_encoder_create(codec_id, &decoder_impl->container, stream, decoder_impl, &encoder);
+    create_hr = async_encoder_create(encoder, hr, value);
+    if (encoder) IBitmapEncoder_Release(encoder);
+    return create_hr;
+}
