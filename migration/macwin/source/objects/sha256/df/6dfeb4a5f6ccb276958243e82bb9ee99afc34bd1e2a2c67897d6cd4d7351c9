+    if (impl->decoder)
+    {
+        width = transform->scaled_width ? transform->scaled_width : impl->decoder->width;
+        height = transform->scaled_height ? transform->scaled_height : impl->decoder->height;
+    }
+    else
+    {
+        width = impl->pixel_width;
+        height = impl->pixel_height;
+    }
+    if (!width || !height) return E_INVALIDARG;
+    if (FAILED(hr = CreateStreamOnHGlobal(NULL, TRUE, &output))) goto done;
+    if (FAILED(hr = CoCreateInstance(&CLSID_WICImagingFactory, NULL, CLSCTX_INPROC_SERVER,
+            &IID_IWICImagingFactory, (void **)&factory))) goto done;
+    if (FAILED(hr = IWICImagingFactory_CreateEncoder(factory, &impl->container, NULL, &encoder))) goto done;
+    if (FAILED(hr = IWICBitmapEncoder_Initialize(encoder, output, WICBitmapEncoderNoCache))) goto done;
+    if (FAILED(hr = IWICBitmapEncoder_CreateNewFrame(encoder, &frame, &options))) goto done;
+    if (FAILED(hr = IWICBitmapFrameEncode_Initialize(frame, options))) goto done;
+    if (FAILED(hr = IWICBitmapFrameEncode_SetSize(frame, width, height))) goto done;
+    if (FAILED(hr = IWICBitmapFrameEncode_SetResolution(frame,
+            impl->decoder ? impl->decoder->dpi_x : impl->pixel_dpi_x,
+            impl->decoder ? impl->decoder->dpi_y : impl->pixel_dpi_y))) goto done;
+    if (FAILED(hr = IWICBitmapFrameEncode_SetPixelFormat(frame, &pixel_format))) goto done;
+    if (impl->decoder)
+    {
+        source = (IWICBitmapSource *)impl->decoder->wic_frame;
+        if (width != impl->decoder->width || height != impl->decoder->height)
+        {
+            if (FAILED(hr = IWICImagingFactory_CreateBitmapScaler(factory, &scaler))) goto done;
+            if (FAILED(hr = IWICBitmapScaler_Initialize(scaler, source, width, height,
+                    map_interpolation(transform->interpolation)))) goto done;
+            source = (IWICBitmapSource *)scaler;
+        }
+    }
+    else
+    {
+        if (!impl->pixels)
+        {
+            hr = WINCODEC_ERR_WRONGSTATE;
+            goto done;
+        }
+        if (FAILED(hr = IWICImagingFactory_CreateBitmapFromMemory(factory, width, height,
+                &GUID_WICPixelFormat32bppPBGRA, width * 4, impl->pixel_size, impl->pixels,
+                &bitmap))) goto done;
+        source = (IWICBitmapSource *)bitmap;
+    }
+    if (FAILED(hr = IWICBitmapFrameEncode_WriteSource(frame, source, NULL))) goto done;
+    if (FAILED(hr = IWICBitmapFrameEncode_Commit(frame))) goto done;
+    if (FAILED(hr = IWICBitmapEncoder_Commit(encoder))) goto done;
+    hr = istream_to_random_access_stream(output, impl->output);
+
+done:
+    if (options) IPropertyBag2_Release(options);
+    if (bitmap) IWICBitmap_Release(bitmap);
+    if (scaler) IWICBitmapScaler_Release(scaler);
+    if (frame) IWICBitmapFrameEncode_Release(frame);
+    if (encoder) IWICBitmapEncoder_Release(encoder);
+    if (factory) IWICImagingFactory_Release(factory);
+    if (output) IStream_Release(output);
+    return hr;
+}
