+static HRESULT bitmap_decoder_create(IRandomAccessStream *stream, IBitmapDecoder **out)
+{
+    struct bitmap_decoder *impl = NULL;
+    IWICImagingFactory *factory = NULL;
+    IStream *input = NULL;
+    const GUID *codec_id;
+    HRESULT hr;
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!stream) return E_INVALIDARG;
+    if (!(impl = calloc(1, sizeof(*impl)))) return E_OUTOFMEMORY;
+    impl->IBitmapDecoder_iface.lpVtbl = &decoder_vtbl;
+    impl->IBitmapFrame_iface.lpVtbl = &frame_vtbl;
+    impl->ref = 1;
+    if (FAILED(hr = random_access_stream_to_istream(stream, &input))) goto failed;
+    if (FAILED(hr = CoCreateInstance(&CLSID_WICImagingFactory, NULL, CLSCTX_INPROC_SERVER,
+            &IID_IWICImagingFactory, (void **)&factory))) goto failed;
+    if (FAILED(hr = IWICImagingFactory_CreateDecoderFromStream(factory, input, NULL,
+            WICDecodeMetadataCacheOnDemand, &impl->wic_decoder))) goto failed;
+    if (FAILED(hr = IWICBitmapDecoder_GetContainerFormat(impl->wic_decoder, &impl->container))) goto failed;
+    if (FAILED(hr = IWICBitmapDecoder_GetFrame(impl->wic_decoder, 0, &impl->wic_frame))) goto failed;
+    if (FAILED(hr = IWICBitmapFrameDecode_GetSize(impl->wic_frame, &impl->width, &impl->height))) goto failed;
+    if (FAILED(IWICBitmapFrameDecode_GetResolution(impl->wic_frame, &impl->dpi_x, &impl->dpi_y)) ||
+            impl->dpi_x <= 0.0 || impl->dpi_y <= 0.0) impl->dpi_x = impl->dpi_y = 96.0;
+    codec_id = decoder_id_from_container(&impl->container);
+    impl->codec_id = *codec_id;
+    *out = &impl->IBitmapDecoder_iface;
+    hr = S_OK;
+
+failed:
+    if (factory) IWICImagingFactory_Release(factory);
+    if (input) IStream_Release(input);
+    if (FAILED(hr) && impl) decoder_Release(&impl->IBitmapDecoder_iface);
+    return hr;
