+    transform_impl = impl_from_IBitmapTransform(transform);
+    width = transform_impl->scaled_width ? transform_impl->scaled_width : impl->width;
+    height = transform_impl->scaled_height ? transform_impl->scaled_height : impl->height;
+    source = (IWICBitmapSource *)impl->wic_frame;
