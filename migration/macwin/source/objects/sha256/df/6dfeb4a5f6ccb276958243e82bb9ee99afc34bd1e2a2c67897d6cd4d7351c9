+HRESULT imaging_get_activation_factory(HSTRING classid, IActivationFactory **factory)
+{
+    const WCHAR *name;
+    if (!factory) return E_POINTER;
+    *factory = NULL;
+    name = WindowsGetStringRawBuffer(classid, NULL);
+    if (!wcscmp(name, RuntimeClass_Windows_Graphics_Imaging_BitmapDecoder))
+        *factory = &decoder_factory.IActivationFactory_iface;
+    else if (!wcscmp(name, RuntimeClass_Windows_Graphics_Imaging_BitmapEncoder))
+        *factory = &encoder_factory.IActivationFactory_iface;
+    else if (!wcscmp(name, RuntimeClass_Windows_Graphics_Imaging_BitmapTransform))
+        *factory = &transform_factory.IActivationFactory_iface;
+    return *factory ? S_OK : CLASS_E_CLASSNOTAVAILABLE;
+}
