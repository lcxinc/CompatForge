+static HRESULT random_access_stream_to_istream(IRandomAccessStream *stream, IStream **out)
+{
+    IAsyncOperationWithProgress_IBuffer_UINT32 *operation = NULL;
+    IBufferByteAccess *byte_access = NULL;
+    IInputStream *input = NULL;
+    IBuffer *buffer = NULL, *result = NULL;
+    HGLOBAL global = NULL;
+    UINT64 size64;
+    UINT32 size, length;
+    BYTE *source;
+    void *destination;
+    HRESULT hr;
+
+    if (!stream || !out) return E_POINTER;
+    *out = NULL;
+    if (SUCCEEDED(IRandomAccessStream_QueryInterface(stream, &IID_IStream, (void **)out))) return S_OK;
+    if (FAILED(hr = IRandomAccessStream_get_Size(stream, &size64))) return hr;
+    if (size64 > UINT32_MAX) return HRESULT_FROM_WIN32(ERROR_FILE_TOO_LARGE);
+    size = size64;
+    if (FAILED(hr = create_buffer(size, &buffer))) goto done;
+    if (FAILED(hr = IRandomAccessStream_Seek(stream, 0))) goto done;
+    hr = IRandomAccessStream_QueryInterface(stream, &IID_IInputStream, (void **)&input);
+    if (FAILED(hr) && FAILED(hr = IRandomAccessStream_GetInputStreamAt(stream, 0, &input))) goto done;
+    if (FAILED(hr = IInputStream_ReadAsync(input, buffer, size, InputStreamOptions_None, &operation))) goto done;
+    if (FAILED(hr = wait_for_async((IInspectable *)operation))) goto done;
+    if (FAILED(hr = IAsyncOperationWithProgress_IBuffer_UINT32_GetResults(operation, &result))) goto done;
+    if (FAILED(hr = IBuffer_get_Length(result, &length))) goto done;
+    if (FAILED(hr = IBuffer_QueryInterface(result, &IID_IBufferByteAccess, (void **)&byte_access))) goto done;
+    if (FAILED(hr = IBufferByteAccess_Buffer(byte_access, &source))) goto done;
+    if (!(global = GlobalAlloc(GMEM_MOVEABLE, length ? length : 1)))
+    {
+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+    if (!(destination = GlobalLock(global)))
+    {
+        hr = HRESULT_FROM_WIN32(GetLastError());
+        goto done;
+    }
+    if (length) memcpy(destination, source, length);
+    GlobalUnlock(global);
+    if (FAILED(hr = CreateStreamOnHGlobal(global, TRUE, out))) goto done;
+    global = NULL;
+
+done:
+    if (global) GlobalFree(global);
+    if (byte_access) IBufferByteAccess_Release(byte_access);
+    if (result) IBuffer_Release(result);
+    if (operation) IAsyncOperationWithProgress_IBuffer_UINT32_Release(operation);
+    if (input) IInputStream_Release(input);
+    if (buffer) IBuffer_Release(buffer);
+    return hr;
+}
