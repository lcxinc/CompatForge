+static HRESULT WINAPI frame_GetPixelDataTransformedAsync(IBitmapFrame *iface, BitmapPixelFormat format,
+        BitmapAlphaMode alpha, IBitmapTransform *transform, ExifOrientationMode orientation,
+        ColorManagementMode color_management, IAsyncOperation_PixelDataProvider **value)
+{
+    struct bitmap_decoder *impl = impl_from_IBitmapFrame(iface);
+    struct bitmap_transform *transform_impl;
+    IWICImagingFactory *factory = NULL;
+    IWICBitmapScaler *scaler = NULL;
+    IWICBitmapClipper *clipper = NULL;
+    IWICFormatConverter *converter = NULL;
+    IWICBitmapSource *source;
+    IPixelDataProvider *provider = NULL;
+    WICRect rect;
+    UINT32 width, height, stride, size;
+    BYTE *pixels = NULL;
+    HRESULT hr, create_hr;
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (!transform || format != BitmapPixelFormat_Bgra8 || alpha != BitmapAlphaMode_Premultiplied)
