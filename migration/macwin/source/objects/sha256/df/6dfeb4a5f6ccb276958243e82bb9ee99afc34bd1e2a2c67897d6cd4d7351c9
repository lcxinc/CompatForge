+static HRESULT istream_to_random_access_stream(IStream *source, IRandomAccessStream *stream)
+{
+    IAsyncOperationWithProgress_UINT32_UINT32 *write_operation = NULL;
+    IAsyncOperation_boolean *flush_operation = NULL;
+    IBufferByteAccess *byte_access = NULL;
+    IOutputStream *output = NULL;
+    IBuffer *buffer = NULL;
+    HGLOBAL global;
+    UINT32 written, size;
+    boolean flushed;
+    BYTE *destination;
+    void *data = NULL;
+    HRESULT hr;
+
+    if (FAILED(hr = GetHGlobalFromStream(source, &global))) return hr;
+    if (GlobalSize(global) > UINT32_MAX) return HRESULT_FROM_WIN32(ERROR_FILE_TOO_LARGE);
+    size = GlobalSize(global);
+    if (!(data = GlobalLock(global))) return HRESULT_FROM_WIN32(GetLastError());
+    if (FAILED(hr = create_buffer(size, &buffer))) goto done;
+    if (FAILED(hr = IBuffer_QueryInterface(buffer, &IID_IBufferByteAccess, (void **)&byte_access))) goto done;
+    if (FAILED(hr = IBufferByteAccess_Buffer(byte_access, &destination))) goto done;
+    if (size) memcpy(destination, data, size);
+    if (FAILED(hr = IBuffer_put_Length(buffer, size))) goto done;
+    if (FAILED(hr = IRandomAccessStream_put_Size(stream, 0))) goto done;
+    if (FAILED(hr = IRandomAccessStream_Seek(stream, 0))) goto done;
+    hr = IRandomAccessStream_QueryInterface(stream, &IID_IOutputStream, (void **)&output);
+    if (FAILED(hr) && FAILED(hr = IRandomAccessStream_GetOutputStreamAt(stream, 0, &output))) goto done;
+    if (FAILED(hr = IOutputStream_WriteAsync(output, buffer, &write_operation))) goto done;
+    if (FAILED(hr = wait_for_async((IInspectable *)write_operation))) goto done;
+    if (FAILED(hr = IAsyncOperationWithProgress_UINT32_UINT32_GetResults(write_operation, &written))) goto done;
+    if (written != size)
+    {
+        hr = STG_E_MEDIUMFULL;
+        goto done;
+    }
+    if (FAILED(hr = IOutputStream_FlushAsync(output, &flush_operation))) goto done;
+    if (FAILED(hr = wait_for_async((IInspectable *)flush_operation))) goto done;
+    if (FAILED(hr = IAsyncOperation_boolean_GetResults(flush_operation, &flushed))) goto done;
+    if (!flushed) hr = STG_E_WRITEFAULT;
+
+done:
+    if (data) GlobalUnlock(global);
+    if (flush_operation) IAsyncOperation_boolean_Release(flush_operation);
+    if (write_operation) IAsyncOperationWithProgress_UINT32_UINT32_Release(write_operation);
+    if (output) IOutputStream_Release(output);
+    if (byte_access) IBufferByteAccess_Release(byte_access);
+    if (buffer) IBuffer_Release(buffer);
+    return hr;
+}
