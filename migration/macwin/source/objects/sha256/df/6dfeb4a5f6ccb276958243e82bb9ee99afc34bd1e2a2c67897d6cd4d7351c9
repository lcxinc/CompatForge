+static const GUID *encoder_container_from_id(REFGUID id)
+{
+    if (IsEqualGUID(id, &CLSID_WICBmpEncoder)) return &GUID_ContainerFormatBmp;
+    if (IsEqualGUID(id, &CLSID_WICJpegEncoder)) return &GUID_ContainerFormatJpeg;
+    if (IsEqualGUID(id, &CLSID_WICPngEncoder)) return &GUID_ContainerFormatPng;
+    if (IsEqualGUID(id, &CLSID_WICTiffEncoder)) return &GUID_ContainerFormatTiff;
+    if (IsEqualGUID(id, &CLSID_WICGifEncoder)) return &GUID_ContainerFormatGif;
+    if (IsEqualGUID(id, &CLSID_WICWmpEncoder)) return &GUID_ContainerFormatWmp;
+    return NULL;
+}
