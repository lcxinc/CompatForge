+static HRESULT bitmap_encoder_create(REFGUID codec_id, REFGUID container, IRandomAccessStream *output,
+        struct bitmap_decoder *decoder, IBitmapEncoder **out)
+{
+    struct bitmap_encoder *impl;
+    HRESULT hr;
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!output) return E_INVALIDARG;
+    if (!(impl = calloc(1, sizeof(*impl)))) return E_OUTOFMEMORY;
+    impl->IBitmapEncoder_iface.lpVtbl = &encoder_vtbl;
+    impl->ref = 1;
+    impl->codec_id = *codec_id;
+    impl->container = *container;
+    impl->output = output;
+    IRandomAccessStream_AddRef(output);
+    impl->decoder = decoder;
+    if (decoder) decoder_AddRef(&decoder->IBitmapDecoder_iface);
+    if (FAILED(hr = bitmap_transform_create(&impl->transform)))
+    {
+        encoder_Release(&impl->IBitmapEncoder_iface);
+        return hr;
+    }
+    *out = &impl->IBitmapEncoder_iface;
+    return S_OK;
+}
