+        HeapFree(GetProcessHeap(), 0, dos_path);
+        COMDLG32_SetCommDlgExtendedError(FNERR_BUFFERTOOSMALL);
+        return WINE_NATIVE_DIALOG_BUFFER_TOO_SMALL;
+    }
+
+    lstrcpyW(ofn->lpstrFile, dos_path);
+    file_part = PathFindFileNameW(ofn->lpstrFile);
+    ofn->nFileOffset = file_part - ofn->lpstrFile;
+    extension = PathFindExtensionW(file_part);
+    ofn->nFileExtension = *extension ? extension - ofn->lpstrFile + 1 : 0;
+    if (ofn->lpstrFileTitle && ofn->nMaxFileTitle)
+        lstrcpynW(ofn->lpstrFileTitle, file_part, ofn->nMaxFileTitle);
+    HeapFree(GetProcessHeap(), 0, dos_path);
+    COMDLG32_SetCommDlgExtendedError(0);
+    return WINE_NATIVE_DIALOG_SUCCESS;
+}
