+int macdrv_run_native_file_dialog(bool save, const uint16_t *title, const char *directory,
+                                  const uint16_t *name, const uint16_t *filter,
+                                  const uint16_t *default_ext, char *path, uint32_t path_size,
+                                  uint32_t flags, uint32_t options,
+                                  const uint16_t *ok_label, const uint16_t *cancel_label,
+                                  const uint16_t *file_name_label, char *paths,
+                                  uint32_t paths_size, uint32_t *filter_index,
+                                  uint32_t *path_count)
+{
+    __block int result = MACWIN_NATIVE_DIALOG_UNAVAILABLE;
+
+    OnMainThread(^{
+        NSSavePanel *panel;
+        NSOpenPanel *open_panel = nil;
+        NSMutableArray *filter_titles = [NSMutableArray array];
+        NSMutableArray *filter_types = [NSMutableArray array];
+        MacWinFileTypeSelector *selector = nil;
+        NSPopUpButton *filter_menu = nil;
+        NSUInteger selected_filter;
+        NSString *extension;
+        BOOL pick_folders = options & WINE_NATIVE_FILE_DIALOG_PICK_FOLDERS;
+        BOOL multi_select = options & WINE_NATIVE_FILE_DIALOG_MULTI_SELECT;
+        NSMutableArray *selected_paths;
+
+        if (save)
+        {
+            if (pick_folders)
+            {
+                result = MACWIN_NATIVE_DIALOG_UNAVAILABLE;
+                return;
+            }
+            panel = [NSSavePanel savePanel];
+        }
+        else
+        {
+            open_panel = [NSOpenPanel openPanel];
+            open_panel.canChooseFiles = !pick_folders;
+            open_panel.canChooseDirectories = pick_folders;
+            open_panel.allowsMultipleSelection = multi_select;
+            open_panel.resolvesAliases = !(options & WINE_NATIVE_FILE_DIALOG_NO_ALIASES);
+            panel = open_panel;
+        }
+
+        panel.allowedContentTypes = @[];
+        panel.allowsOtherFileTypes = YES;
+        if (title && *title)
+            panel.title = [NSString stringWithCharacters:title length:utf16_length(title)];
+        if (ok_label && *ok_label)
+            panel.prompt = [NSString stringWithCharacters:ok_label length:utf16_length(ok_label)];
+        if (file_name_label && *file_name_label && !pick_folders)
+            panel.nameFieldLabel = [NSString stringWithCharacters:file_name_label length:utf16_length(file_name_label)];
+        if (!native_file_filter_list(filter, filter_titles, filter_types))
+        {
+            result = MACWIN_NATIVE_DIALOG_UNAVAILABLE;
+            return;
+        }
+        selected_filter = filter_index && *filter_index ? *filter_index - 1 : 0;
+        if ([filter_types count] && selected_filter >= [filter_types count]) selected_filter = 0;
+        if ([filter_types count])
+        {
+            selector = [[MacWinFileTypeSelector alloc] initWithPanel:panel types:filter_types index:selected_filter];
+            if ([filter_types count] > 1)
+            {
+                filter_menu = [[NSPopUpButton alloc] initWithFrame:NSMakeRect(0, 0, 280, 26)
+                                                       pullsDown:NO];
+                [filter_menu addItemsWithTitles:filter_titles];
+                [filter_menu selectItemAtIndex:selected_filter];
+                [filter_menu setTarget:selector];
+                [filter_menu setAction:@selector(selectionChanged:)];
+                panel.accessoryView = filter_menu;
+                if (open_panel) open_panel.accessoryViewDisclosed = YES;
+            }
+        }
+        if (directory && *directory)
+        {
+            NSString *directory_string = [NSString stringWithUTF8String:directory];
+            if (directory_string) panel.directoryURL = [NSURL fileURLWithPath:directory_string isDirectory:YES];
+        }
+        if (name && *name)
+            panel.nameFieldStringValue = [NSString stringWithCharacters:name length:utf16_length(name)];
+        extension = native_default_extension(default_ext);
+        if (save && extension && panel.nameFieldStringValue.length &&
+            ![panel.nameFieldStringValue pathExtension].length)
+            panel.nameFieldStringValue = [panel.nameFieldStringValue stringByAppendingPathExtension:extension];
+
+        prepare_native_dialog_window(panel);
+        if ([panel runModal] != NSModalResponseOK)
+        {
+            result = MACWIN_NATIVE_DIALOG_CANCELLED;
+            [filter_menu release];
+            [selector release];
+            return;
+        }
+
+        selected_paths = [NSMutableArray array];
+        if (save)
+        {
+            NSString *selected = panel.URL.path;
+            if (selected)
+            {
+                if (extension && ![selected pathExtension].length)
+                    selected = [selected stringByAppendingPathExtension:extension];
+                [selected_paths addObject:selected];
+            }
+        }
+        else
+        {
+            for (NSURL *url in open_panel.URLs)
+                if (url.path) [selected_paths addObject:url.path];
+        }
+        if (![selected_paths count])
+        {
+            [filter_menu release];
+            [selector release];
+            return;
+        }
+
+        NSMutableData *path_data = [NSMutableData data];
+        for (NSString *selected in selected_paths)
+        {
+            const char *selected_path = selected.fileSystemRepresentation;
+            if (!selected_path || path_data.length + strlen(selected_path) + 1 > paths_size)
+            {
+                result = MACWIN_NATIVE_DIALOG_BUFFER_TOO_SMALL;
+                [filter_menu release];
+                [selector release];
+                return;
+            }
+            [path_data appendBytes:selected_path length:strlen(selected_path) + 1];
+        }
+
+        memcpy(paths, path_data.bytes, path_data.length);
+        if (filter_index && selector) *filter_index = (uint32_t)[selector selectedIndex] + 1;
+        if (path_count) *path_count = (uint32_t)[selected_paths count];
+        result = MACWIN_NATIVE_DIALOG_SUCCESS;
+        [filter_menu release];
+        [selector release];
+    });
+
+    return result;
+}
+
+static NSString *native_task_button_title(uint32_t id, const uint16_t *text)
+{
+    if (text && *text)
+        return [NSString stringWithCharacters:text length:utf16_length(text)];
+
+    switch (id)
+    {
+    case MACWIN_IDOK: return uses_chinese() ? @"确定" : @"OK";
+    case MACWIN_IDYES: return uses_chinese() ? @"是" : @"Yes";
+    case MACWIN_IDNO: return uses_chinese() ? @"否" : @"No";
+    case MACWIN_IDCANCEL: return uses_chinese() ? @"取消" : @"Cancel";
+    case MACWIN_IDRETRY: return uses_chinese() ? @"重试" : @"Retry";
+    case 8: return uses_chinese() ? @"关闭" : @"Close";
+    default: return [NSString stringWithFormat:@"%u", id];
+    }
+}
