+static NSString *native_default_extension(const uint16_t *default_ext)
+{
+    if (!default_ext || !*default_ext) return nil;
+    NSString *extension = [NSString stringWithCharacters:default_ext length:utf16_length(default_ext)];
+    if ([extension hasPrefix:@"."]) extension = [extension substringFromIndex:1];
+    if (![extension length] || [extension rangeOfString:@"*"].location != NSNotFound ||
+        [extension rangeOfString:@"?"].location != NSNotFound)
+        return nil;
+    return extension;
+}
