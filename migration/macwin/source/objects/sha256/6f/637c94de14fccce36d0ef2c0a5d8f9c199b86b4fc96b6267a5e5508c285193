+static WCHAR *native_itemdlg_filter(FileDialogImpl *This)
+{
+    WCHAR *filter, *cursor;
+    UINT i, length = 1;
+
+    if (!This->filterspec_count) return NULL;
+    for (i = 0; i < This->filterspec_count; i++)
+        length += lstrlenW(This->filterspecs[i].pszName) + 1
+                + lstrlenW(This->filterspecs[i].pszSpec) + 1;
+    filter = malloc(length * sizeof(*filter));
+    if (!filter) return NULL;
+    cursor = filter;
+    for (i = 0; i < This->filterspec_count; i++)
+    {
+        UINT name_len = lstrlenW(This->filterspecs[i].pszName);
+        UINT spec_len = lstrlenW(This->filterspecs[i].pszSpec);
+        memcpy(cursor, This->filterspecs[i].pszName, (name_len + 1) * sizeof(*cursor));
+        cursor += name_len + 1;
+        memcpy(cursor, This->filterspecs[i].pszSpec, (spec_len + 1) * sizeof(*cursor));
+        cursor += spec_len + 1;
+    }
+    *cursor = 0;
+    return filter;
+}
