+static BOOL native_task_dialog_component_enabled(void)
+{
+    char environment[256], token[64];
+    DWORD length, token_length;
+    const char *cursor, *end;
+
+    length = GetEnvironmentVariableA("MACWIN_NATIVE_UI", environment, ARRAY_SIZE(environment));
+    if (!length || length >= ARRAY_SIZE(environment)) return FALSE;
+    cursor = environment;
+    while (*cursor)
+    {
+        while (*cursor == ',' || *cursor == ' ' || *cursor == '\t') cursor++;
+        end = cursor;
+        while (*end && *end != ',') end++;
+        token_length = min((DWORD)(end - cursor), (DWORD)ARRAY_SIZE(token) - 1);
+        memcpy(token, cursor, token_length);
+        token[token_length] = 0;
+        while (token_length && (token[token_length - 1] == ' ' || token[token_length - 1] == '\t'))
+            token[--token_length] = 0;
+        if (!lstrcmpiA(token, "task-dialogs")) return TRUE;
+        cursor = end;
+    }
+    return FALSE;
