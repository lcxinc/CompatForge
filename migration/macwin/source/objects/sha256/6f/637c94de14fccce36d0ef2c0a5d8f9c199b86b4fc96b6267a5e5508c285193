+int macdrv_run_native_task_dialog(const uint16_t *title, const uint16_t *main_instruction,
+                                  const uint16_t *content, const uint16_t *footer,
+                                  const uint16_t *verification_text, uint64_t main_icon,
+                                  const struct wine_native_task_dialog_button *buttons,
+                                  uint32_t button_count, uint32_t default_button, uint32_t flags,
+                                  uint32_t *verification_checked)
+{
+    __block int result = 0;
+    const uint16_t *safe_title = title && macwin_is_intresource(title) ? NULL : title;
+
+    OnMainThread(^{
+        NSAlert *alert;
+        NSButton *suppression;
+        int64_t icon = (int64_t)main_icon;
+        NSUInteger default_index = 0;
+
+        if (!buttons || !button_count || button_count > 32)
+            return;
+        alert = [[NSAlert alloc] init];
+        alert.messageText = main_instruction && *main_instruction
+            ? [NSString stringWithCharacters:main_instruction length:utf16_length(main_instruction)]
+            : (safe_title && *safe_title ? [NSString stringWithCharacters:safe_title length:utf16_length(safe_title)] : @"");
+        alert.informativeText = content && *content
+            ? [NSString stringWithCharacters:content length:utf16_length(content)] : @"";
+        if (footer && *footer)
+        {
+            NSString *footer_text = [NSString stringWithCharacters:footer length:utf16_length(footer)];
+            alert.informativeText = alert.informativeText.length
+                ? [alert.informativeText stringByAppendingFormat:@"\n\n%@", footer_text]
+                : footer_text;
+        }
+        if (safe_title && *safe_title) alert.window.title = [NSString stringWithCharacters:safe_title length:utf16_length(safe_title)];
+
+        if (icon == -2) alert.alertStyle = NSAlertStyleCritical;
+        else if (icon == -1) alert.alertStyle = NSAlertStyleWarning;
+        else alert.alertStyle = NSAlertStyleInformational;
+
+        for (NSUInteger i = 0; i < button_count; i++)
+        {
+            const uint16_t *text = buttons[i].text
+                ? (const uint16_t *)(uintptr_t)buttons[i].text : NULL;
+            NSButton *button = [alert addButtonWithTitle:native_task_button_title(buttons[i].id, text)];
+            button.keyEquivalent = @"";
+            if (buttons[i].id == default_button) default_index = i;
+            if (buttons[i].id == MACWIN_IDCANCEL) button.keyEquivalent = @"\033";
+        }
+        if (default_index < alert.buttons.count)
+            alert.buttons[default_index].keyEquivalent = @"\r";
+
+        if (verification_text && *verification_text)
+        {
+            alert.showsSuppressionButton = YES;
+            suppression = alert.suppressionButton;
+            suppression.title = [NSString stringWithCharacters:verification_text length:utf16_length(verification_text)];
+            suppression.state = (flags & 0x0100) ? NSControlStateValueOn : NSControlStateValueOff;
+        }
+
+        prepare_native_dialog_window(alert.window);
+        NSInteger response = [alert runModal];
+        if (response >= NSAlertFirstButtonReturn &&
+            response < NSAlertFirstButtonReturn + (NSInteger)button_count)
+            result = buttons[response - NSAlertFirstButtonReturn].id;
+        else if (flags & MACWIN_TDF_ALLOW_DIALOG_CANCELLATION)
+            result = MACWIN_IDCANCEL;
+        if (verification_checked && verification_text && *verification_text)
+            *verification_checked = alert.suppressionButton.state == NSControlStateValueOn;
+        [alert release];
+    });
+
+    return result;
+}
