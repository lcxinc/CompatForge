+static INT try_native_file_dialogW(OPENFILENAMEW *ofn, BOOL save)
+{
+    static const DWORD unsupported_flags = OFN_ALLOWMULTISELECT | OFN_ENABLEHOOK |
+                                            OFN_ENABLETEMPLATE | OFN_ENABLETEMPLATEHANDLE;
+    char selected_path[4096];
+    char *initial_directory = NULL;
+    WCHAR *dos_path;
+    const WCHAR *name = NULL;
+    struct wine_native_file_dialog_params params;
+    INT result;
+    UINT length;
+    WCHAR *file_part, *extension;
+
+    if (!native_ui_component_enabled("file-dialogs") || !ofn->lpstrFile || !ofn->nMaxFile ||
+        ofn->lpstrCustomFilter ||
+        (ofn->Flags & unsupported_flags) || IS_INTRESOURCE(ofn->lpstrTitle))
+        return WINE_NATIVE_DIALOG_UNAVAILABLE;
+
+    if (ofn->lpstrInitialDir && *ofn->lpstrInitialDir)
+        initial_directory = wine_get_unix_file_name(ofn->lpstrInitialDir);
+    if (*ofn->lpstrFile) name = PathFindFileNameW(ofn->lpstrFile);
+
+    params.hwnd = (UINT_PTR)ofn->hwndOwner;
+    params.title = (UINT_PTR)ofn->lpstrTitle;
+    params.directory = (UINT_PTR)initial_directory;
+    params.name = (UINT_PTR)name;
+    params.filter = (UINT_PTR)ofn->lpstrFilter;
+    params.default_ext = (UINT_PTR)ofn->lpstrDefExt;
+    params.path = (UINT_PTR)selected_path;
+    params.path_size = ARRAY_SIZE(selected_path);
+    params.flags = ofn->Flags;
+    params.save = save;
+    params.filter_index = ofn->nFilterIndex ? ofn->nFilterIndex : 1;
+    params.result = WINE_NATIVE_DIALOG_UNAVAILABLE;
+    if (!SystemParametersInfoW(SPI_WINE_NATIVE_FILE_DIALOG, 0, &params, 0))
+        result = WINE_NATIVE_DIALOG_UNAVAILABLE;
+    else
+        result = params.result;
+    HeapFree(GetProcessHeap(), 0, initial_directory);
+    if (result == WINE_NATIVE_DIALOG_CANCELLED)
+        COMDLG32_SetCommDlgExtendedError(0);
+    if (result != WINE_NATIVE_DIALOG_SUCCESS) return result;
+
+    if (params.filter_index) ofn->nFilterIndex = params.filter_index;
+
+    if (!(dos_path = wine_get_dos_file_name(selected_path)))
+        return WINE_NATIVE_DIALOG_UNAVAILABLE;
+    length = lstrlenW(dos_path) + 1;
+    if (length > ofn->nMaxFile)
