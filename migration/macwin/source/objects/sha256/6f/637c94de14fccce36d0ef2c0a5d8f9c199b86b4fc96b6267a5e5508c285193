+static HRESULT native_itemdlg_set_results(FileDialogImpl *This, const char *paths,
+                                           UINT path_count, UINT paths_size, BOOL pick_folders)
+{
+    LPITEMIDLIST *pidla = NULL;
+    WCHAR *folder_path = NULL;
+    const char *cursor = paths;
+    IShellFolder *desktop = NULL;
+    IShellItemArray *results = NULL;
+    HRESULT hr = E_FAIL;
+    UINT i;
+
+    if (!path_count || !paths) return E_FAIL;
+    pidla = calloc(path_count, sizeof(*pidla));
+    if (!pidla) return E_OUTOFMEMORY;
+
+    for (i = 0; i < path_count; i++)
+    {
+        const char *end;
+        WCHAR *dos_path;
+        UINT length;
+
+        if (cursor < paths || (UINT_PTR)(cursor - paths) >= paths_size)
+        {
+            hr = E_FAIL;
+            goto done;
+        }
+        end = memchr(cursor, 0, paths_size - (UINT_PTR)(cursor - paths));
+
+        if (!end || end == cursor)
+        {
+            hr = E_FAIL;
+            goto done;
+        }
+        dos_path = wine_get_dos_file_name(cursor);
+        if (!dos_path)
+        {
+            hr = E_FAIL;
+            goto done;
+        }
+        if (!i)
+        {
+            length = lstrlenW(dos_path) + 1;
+            folder_path = malloc(length * sizeof(*folder_path));
+            if (!folder_path)
+            {
+                HeapFree(GetProcessHeap(), 0, dos_path);
+                hr = E_OUTOFMEMORY;
+                goto done;
+            }
+            lstrcpyW(folder_path, dos_path);
+            if (!pick_folders) PathRemoveFileSpecW(folder_path);
+        }
+        pidla[i] = SHSimpleIDListFromPath(dos_path);
+        HeapFree(GetProcessHeap(), 0, dos_path);
+        if (!pidla[i])
+        {
+            hr = E_FAIL;
+            goto done;
+        }
+        cursor = end + 1;
+    }
+
+    hr = SHGetDesktopFolder(&desktop);
+    if (SUCCEEDED(hr))
+        hr = SHCreateShellItemArray(NULL, desktop, path_count,
+                                    (PCUITEMID_CHILD_ARRAY)pidla, &results);
+    if (desktop) IShellFolder_Release(desktop);
+    if (FAILED(hr)) goto done;
+
+    if (This->psia_results) IShellItemArray_Release(This->psia_results);
+    This->psia_results = results;
+    if (This->psia_selection) IShellItemArray_Release(This->psia_selection);
+    This->psia_selection = results;
+    IShellItemArray_AddRef(This->psia_selection);
+
+    if (folder_path)
+    {
+        IShellItem *folder = NULL;
+        if (SUCCEEDED(SHCreateItemFromParsingName(folder_path, NULL, &IID_IShellItem,
+                                                  (void **)&folder)))
+        {
+            if (This->psi_folder) IShellItem_Release(This->psi_folder);
+            This->psi_folder = folder;
+        }
+    }
+    hr = S_OK;
+
+done:
+    if (pidla)
+    {
+        for (i = 0; i < path_count; i++) ILFree(pidla[i]);
+        free(pidla);
+    }
+    free(folder_path);
+    return hr;
+}
