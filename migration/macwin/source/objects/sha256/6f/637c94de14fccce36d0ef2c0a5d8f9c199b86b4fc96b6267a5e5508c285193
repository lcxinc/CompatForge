+}
+
+- (void)applySelection
+{
+    NSArray *extensions = [types objectAtIndex:selectedIndex];
+    NSMutableArray *contentTypes = [NSMutableArray array];
+    for (NSString *extension in extensions)
+    {
+        UTType *type = [UTType typeWithFilenameExtension:extension];
+        if (type) [contentTypes addObject:type];
+    }
+    panel.allowedContentTypes = contentTypes;
+    panel.allowsOtherFileTypes = ![contentTypes count];
+}
+
+- (void)selectionChanged:(id)sender
+{
+    NSInteger index = [sender indexOfSelectedItem];
+    if (index < 0 || (NSUInteger)index >= [types count]) return;
+    selectedIndex = index;
+    [self applySelection];
+}
