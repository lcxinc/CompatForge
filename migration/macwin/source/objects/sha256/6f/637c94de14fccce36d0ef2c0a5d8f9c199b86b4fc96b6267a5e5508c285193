+static BOOL native_file_filter_list(const uint16_t *filter, NSMutableArray *titles,
+                                    NSMutableArray *types)
+{
+    const uint16_t *cursor = filter;
+
+    if (!cursor || !*cursor) return TRUE;
+    while (*cursor)
+    {
+        NSString *title = [NSString stringWithCharacters:cursor length:utf16_length(cursor)];
+        cursor += utf16_length(cursor) + 1;
+        if (!*cursor) return FALSE;
+
+        NSString *specification = [NSString stringWithCharacters:cursor length:utf16_length(cursor)];
+        NSMutableArray *extensions = [NSMutableArray array];
+        BOOL allowsAll = NO;
+        NSArray *patterns = [specification componentsSeparatedByString:@";"];
+        for (NSString *rawPattern in patterns)
+        {
+            NSString *pattern = [rawPattern stringByTrimmingCharactersInSet:
+                                 [NSCharacterSet whitespaceAndNewlineCharacterSet]];
+            if ([pattern isEqualToString:@"*"] || [pattern isEqualToString:@"*.*"])
+            {
+                allowsAll = YES;
+                continue;
+            }
+            if (![pattern hasPrefix:@"*."] || [pattern length] <= 2)
+                return FALSE;
+            NSString *extension = [pattern substringFromIndex:2];
+            if ([extension rangeOfString:@"*"].location != NSNotFound ||
+                [extension rangeOfString:@"?"].location != NSNotFound)
+                return FALSE;
+            [extensions addObject:[extension lowercaseString]];
+        }
+        if (!allowsAll && ![extensions count]) return FALSE;
+        [titles addObject:[title length] ? title : specification];
+        [types addObject:allowsAll ? @[] : extensions];
+        cursor += utf16_length(cursor) + 1;
+    }
+    return [titles count] != 0;
+}
