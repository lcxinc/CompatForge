+        alert.messageText = title && *title
+            ? [NSString stringWithCharacters:title length:utf16_length(title)]
+            : [[NSProcessInfo processInfo] processName];
+        alert.informativeText = text && *text
+            ? [NSString stringWithCharacters:text length:utf16_length(text)]
+            : @"";
+
+        switch (type & MACWIN_MB_ICONMASK)
+        {
+        case MACWIN_MB_ICONERROR:
+            alert.alertStyle = NSAlertStyleCritical;
+            break;
+        case MACWIN_MB_ICONWARNING:
+            alert.alertStyle = NSAlertStyleWarning;
+            break;
+        default:
+            alert.alertStyle = NSAlertStyleInformational;
+            break;
+        }
+
+        for (NSUInteger i = 0; i < count; i++)
+        {
+            NSButton *button = [alert addButtonWithTitle:localized_button_title(&native_buttons[i])];
+            button.keyEquivalent = @"";
+            if (native_buttons[i].id == MACWIN_IDCANCEL) button.keyEquivalent = @"\033";
+        }
+        if (default_index >= count) default_index = 0;
+        alert.buttons[default_index].keyEquivalent = @"\r";
+
+        prepare_native_dialog_window(alert.window);
+        NSInteger response = [alert runModal];
+        if (response >= NSAlertFirstButtonReturn &&
+            response < NSAlertFirstButtonReturn + (NSInteger)count)
+            result = native_buttons[response - NSAlertFirstButtonReturn].id;
+
+        [alert release];
+    });
+
+    return result;
+}
