+struct json_string_buffer
+{
+    WCHAR *data;
+    size_t length;
+    size_t capacity;
+};
+
+static HRESULT json_string_reserve( struct json_string_buffer *buffer, size_t count )
+{
+    WCHAR *data;
+    size_t capacity;
+
+    if (count <= buffer->capacity - buffer->length) return S_OK;
+    capacity = max( buffer->capacity * 2, buffer->length + count + 32 );
+    if (!(data = realloc( buffer->data, capacity * sizeof(*data) ))) return E_OUTOFMEMORY;
+    buffer->data = data;
+    buffer->capacity = capacity;
+    return S_OK;
+}
+
+static HRESULT json_string_append( struct json_string_buffer *buffer, const WCHAR *string, size_t length )
+{
+    HRESULT hr;
+
+    if (FAILED(hr = json_string_reserve( buffer, length ))) return hr;
+    memcpy( buffer->data + buffer->length, string, length * sizeof(*string) );
+    buffer->length += length;
+    return S_OK;
+}
+
+static HRESULT json_string_append_escaped( struct json_string_buffer *buffer, HSTRING string )
+{
+    const WCHAR *value = WindowsGetStringRawBuffer( string, NULL );
+    UINT32 length = WindowsGetStringLen( string );
+    HRESULT hr;
+    UINT32 i;
+
+    if (FAILED(hr = json_string_append( buffer, L"\"", 1 ))) return hr;
+    for (i = 0; i < length; ++i)
+    {
+        WCHAR escape[6];
+        const WCHAR *text = NULL;
+        size_t text_length = 0;
+
+        switch (value[i])
+        {
+        case L'\"': text = L"\\\""; text_length = 2; break;
+        case L'\\': text = L"\\\\"; text_length = 2; break;
+        case L'\b': text = L"\\b"; text_length = 2; break;
+        case L'\f': text = L"\\f"; text_length = 2; break;
+        case L'\n': text = L"\\n"; text_length = 2; break;
+        case L'\r': text = L"\\r"; text_length = 2; break;
+        case L'\t': text = L"\\t"; text_length = 2; break;
+        default:
+            if (value[i] < 0x20)
+            {
+                swprintf( escape, ARRAY_SIZE(escape), L"\\u%04x", value[i] );
+                text = escape;
+                text_length = 6;
+            }
+            else
+            {
+                text = &value[i];
+                text_length = 1;
+            }
+        }
+        if (FAILED(hr = json_string_append( buffer, text, text_length ))) return hr;
+    }
+    return json_string_append( buffer, L"\"", 1 );
+}
+
+static HRESULT json_string_append_value( struct json_string_buffer *buffer, IJsonValue *value )
+{
+    JsonValueType type;
+    HRESULT hr;
+
+    if (FAILED(hr = IJsonValue_get_ValueType( value, &type ))) return hr;
+    switch (type)
+    {
+    case JsonValueType_Null:
+        return json_string_append( buffer, L"null", 4 );
+    case JsonValueType_Boolean:
+    {
+        boolean boolean_value;
+        if (FAILED(hr = IJsonValue_GetBoolean( value, &boolean_value ))) return hr;
+        return json_string_append( buffer, boolean_value ? L"true" : L"false", boolean_value ? 4 : 5 );
+    }
+    case JsonValueType_Number:
+    {
+        WCHAR number[32];
+        DOUBLE number_value;
+        int length;
+        if (FAILED(hr = IJsonValue_GetNumber( value, &number_value ))) return hr;
+        if ((length = swprintf( number, ARRAY_SIZE(number), L"%.17g", number_value )) < 0) return E_FAIL;
+        return json_string_append( buffer, number, length );
+    }
+    case JsonValueType_String:
+    {
+        HSTRING string;
+        if (FAILED(hr = IJsonValue_GetString( value, &string ))) return hr;
+        hr = json_string_append_escaped( buffer, string );
+        WindowsDeleteString( string );
+        return hr;
+    }
+    case JsonValueType_Object:
+    case JsonValueType_Array:
+    {
+        HSTRING string;
+        if (FAILED(hr = IJsonValue_Stringify( value, &string ))) return hr;
+        hr = json_string_append( buffer, WindowsGetStringRawBuffer( string, NULL ), WindowsGetStringLen( string ) );
+        WindowsDeleteString( string );
+        return hr;
+    }
+    default:
+        return E_UNEXPECTED;
+    }
+}
