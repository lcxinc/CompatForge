+    struct json_string_buffer buffer = {0};
+    boolean current;
+    HRESULT hr;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (FAILED(hr = json_string_append( &buffer, L"{", 1 ))) goto done;
+    if (FAILED(hr = IMap_HSTRING_IInspectable_QueryInterface( impl->members,
+            &IID_IIterable_IKeyValuePair_HSTRING_IInspectable, (void **)&iterable ))) goto done;
+    if (FAILED(hr = IIterable_IKeyValuePair_HSTRING_IInspectable_First( iterable, &iterator ))) goto done;
+    if (FAILED(hr = IIterator_IKeyValuePair_HSTRING_IInspectable_get_HasCurrent( iterator, &current ))) goto done;
+
+    while (current)
+    {
+        IKeyValuePair_HSTRING_IInspectable *pair = NULL;
+        IInspectable *inspectable = NULL;
+        IJsonValue *json_value = NULL;
+        HSTRING key = NULL;
+
+        if (buffer.length > 1 && FAILED(hr = json_string_append( &buffer, L",", 1 ))) goto pair_done;
+        if (FAILED(hr = IIterator_IKeyValuePair_HSTRING_IInspectable_get_Current( iterator, &pair ))) goto pair_done;
+        if (FAILED(hr = IKeyValuePair_HSTRING_IInspectable_get_Key( pair, &key ))) goto pair_done;
+        if (FAILED(hr = IKeyValuePair_HSTRING_IInspectable_get_Value( pair, &inspectable ))) goto pair_done;
+        if (FAILED(hr = IInspectable_QueryInterface( inspectable, &IID_IJsonValue, (void **)&json_value ))) goto pair_done;
