+static HRESULT concat_string( HSTRING *current, HSTRING next )
+{
+    HSTRING combined;
+    HRESULT hr = WindowsConcatString( *current, next, &combined );
+    if (SUCCEEDED(hr))
+    {
+        WindowsDeleteString( *current );
+        *current = combined;
+    }
+    return hr;
+}
+
+static HRESULT WINAPI json_value_Stringify( IJsonValue *iface, HSTRING *value )
+{
+    struct json_array *impl = impl_from_IJsonValue( iface );
+    HSTRING separator = NULL, item = NULL;
+    UINT32 i;
+    HRESULT hr;
+    if (!value) return E_POINTER;
+    if (FAILED(hr = WindowsCreateString( L"[", 1, value ))) return hr;
+    for (i = 0; i < impl->length; ++i)
+    {
+        if (i)
+        {
+            WindowsCreateString( L",", 1, &separator );
+            hr = concat_string( value, separator );
+            WindowsDeleteString( separator );
+            if (FAILED(hr)) goto failed;
+        }
+        if (FAILED(hr = IJsonValue_Stringify( impl->elements[i], &item ))) goto failed;
+        hr = concat_string( value, item );
+        WindowsDeleteString( item );
+        item = NULL;
+        if (FAILED(hr)) goto failed;
+    }
+    WindowsCreateString( L"]", 1, &separator );
+    hr = concat_string( value, separator );
+    WindowsDeleteString( separator );
+    return hr;
+failed:
+    if (item) WindowsDeleteString( item );
+    WindowsDeleteString( *value );
+    *value = NULL;
+    return hr;
+}
