+static void Bilinear_GetPosition(UINT dst_pos, UINT src_size, UINT dst_size,
+    UINT *first, UINT *second, UINT *weight)
+{
+    LONGLONG position;
+
+    position = (((LONGLONG)dst_pos * 2 + 1) * src_size * 32768 / dst_size) - 32768;
+    if (position <= 0)
+    {
+        *first = *second = 0;
+        *weight = 0;
+    }
+    else if (position >= ((LONGLONG)src_size - 1) * 65536)
+    {
+        *first = *second = src_size - 1;
+        *weight = 0;
+    }
+    else
+    {
+        *first = position >> 16;
+        *second = *first + 1;
+        *weight = position & 0xffff;
+    }
+}
+
+static void Bilinear_GetRequiredSourceRect(BitmapScaler *This,
+    UINT x, UINT y, WICRect *src_rect)
+{
+    UINT x0, x1, y0, y1, weight;
+
+    Bilinear_GetPosition(x, This->src_width, This->width,
+        &x0, &x1, &weight);
+    Bilinear_GetPosition(y, This->src_height, This->height,
+        &y0, &y1, &weight);
+    src_rect->X = x0;
+    src_rect->Y = y0;
+    src_rect->Width = x1 - x0 + 1;
+    src_rect->Height = y1 - y0 + 1;
+}
+
+static void Bilinear_CopyScanline(BitmapScaler *This,
+    UINT dst_x, UINT dst_y, UINT dst_width,
+    BYTE **src_data, UINT src_data_x, UINT src_data_y, BYTE *pbBuffer)
+{
+    UINT bytesperpixel = This->bpp / 8;
+    UINT y0, y1, y_weight, x0, x1, x_weight;
+    UINT i, channel;
+
+    Bilinear_GetPosition(dst_y, This->src_height, This->height, &y0, &y1, &y_weight);
+    y0 -= src_data_y;
+    y1 -= src_data_y;
+    for (i = 0; i < dst_width; i++)
+    {
+        ULONGLONG inverse_x, inverse_y;
+
+        Bilinear_GetPosition(dst_x + i, This->src_width, This->width, &x0, &x1, &x_weight);
+        x0 -= src_data_x;
+        x1 -= src_data_x;
+        inverse_x = 65536 - x_weight;
+        inverse_y = 65536 - y_weight;
+        for (channel = 0; channel < bytesperpixel; channel++)
+        {
+            ULONGLONG top, bottom, value;
+
+            top = src_data[y0][x0 * bytesperpixel + channel] * inverse_x
+                + src_data[y0][x1 * bytesperpixel + channel] * x_weight;
+            bottom = src_data[y1][x0 * bytesperpixel + channel] * inverse_x
+                + src_data[y1][x1 * bytesperpixel + channel] * x_weight;
+            value = top * inverse_y + bottom * y_weight + ((ULONGLONG)1 << 31);
+            pbBuffer[i * bytesperpixel + channel] = value >> 32;
+        }
+    }
+}
