+static void test_bitmap_scaler_interpolation(void)
+{
+    static const BYTE source[] =
+    {
+          0,   0, 0, 255, 100,   0, 0, 255,
+          0, 100, 0, 255, 100, 100, 0, 255,
+    };
+    static const WICBitmapInterpolationMode modes[] =
+    {
+        WICBitmapInterpolationModeLinear,
+        WICBitmapInterpolationModeCubic,
+        WICBitmapInterpolationModeFant,
+    };
+    IWICBitmap *bitmap;
+    IWICBitmapScaler *scaler;
+    BYTE output[3 * 3 * 4];
+    HRESULT hr;
+    unsigned int i;
+
+    hr = IWICImagingFactory_CreateBitmapFromMemory(factory, 2, 2,
+        &GUID_WICPixelFormat32bppBGRA, 8, sizeof(source), (BYTE *)source, &bitmap);
+    ok(hr == S_OK, "Failed to create source bitmap, hr %#lx.\n", hr);
+
+    for (i = 0; i < ARRAY_SIZE(modes); i++)
+    {
+        hr = IWICImagingFactory_CreateBitmapScaler(factory, &scaler);
+        ok(hr == S_OK, "Failed to create bitmap scaler, hr %#lx.\n", hr);
+        hr = IWICBitmapScaler_Initialize(scaler, (IWICBitmapSource *)bitmap, 3, 3, modes[i]);
+        ok(hr == S_OK, "Failed to initialize mode %u, hr %#lx.\n", modes[i], hr);
+        memset(output, 0xcc, sizeof(output));
+        hr = IWICBitmapScaler_CopyPixels(scaler, NULL, 12, sizeof(output), output);
+        ok(hr == S_OK, "Failed to copy mode %u pixels, hr %#lx.\n", modes[i], hr);
+        ok(output[16] == 50 && output[17] == 50 && output[18] == 0 && output[19] == 255,
+            "Mode %u center pixel is %u,%u,%u,%u.\n", modes[i],
+            output[16], output[17], output[18], output[19]);
+        ok(output[0] == 0 && output[1] == 0 && output[3] == 255,
+            "Mode %u changed the top-left pixel.\n", modes[i]);
+        ok(output[32] == 100 && output[33] == 100 && output[35] == 255,
+            "Mode %u changed the bottom-right pixel.\n", modes[i]);
+        IWICBitmapScaler_Release(scaler);
+    }
+
+    IWICBitmap_Release(bitmap);
+}
