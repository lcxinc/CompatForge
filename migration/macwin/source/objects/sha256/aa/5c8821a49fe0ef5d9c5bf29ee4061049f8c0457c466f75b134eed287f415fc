+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#include <stdarg.h>
+#include <stdlib.h>
+
+#define COBJMACROS
+
+#include "windef.h"
+#include "winbase.h"
+#include "winerror.h"
+
+#include "shell32_main.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(shell);
+
+typedef struct IVirtualDesktopManager IVirtualDesktopManager;
+
+typedef struct IVirtualDesktopManagerVtbl
+{
+    HRESULT (WINAPI *QueryInterface)(IVirtualDesktopManager *iface, REFIID iid, void **out);
+    ULONG (WINAPI *AddRef)(IVirtualDesktopManager *iface);
+    ULONG (WINAPI *Release)(IVirtualDesktopManager *iface);
+    HRESULT (WINAPI *IsWindowOnCurrentVirtualDesktop)(IVirtualDesktopManager *iface, HWND window,
+            BOOL *on_current_desktop);
+    HRESULT (WINAPI *GetWindowDesktopId)(IVirtualDesktopManager *iface, HWND window, GUID *desktop_id);
+    HRESULT (WINAPI *MoveWindowToDesktop)(IVirtualDesktopManager *iface, HWND window, REFGUID desktop_id);
+} IVirtualDesktopManagerVtbl;
+
+struct IVirtualDesktopManager
+{
+    const IVirtualDesktopManagerVtbl *lpVtbl;
+};
+
+static const IID IID_IVirtualDesktopManager =
+    {0xa5cd92ff, 0x29be, 0x454c, {0x8d, 0x04, 0xd8, 0x28, 0x79, 0xfb, 0x3f, 0x1b}};
+
+struct virtual_desktop_manager
+{
+    IVirtualDesktopManager IVirtualDesktopManager_iface;
+    LONG ref;
+};
+
+static inline struct virtual_desktop_manager *impl_from_IVirtualDesktopManager(IVirtualDesktopManager *iface)
+{
+    return CONTAINING_RECORD(iface, struct virtual_desktop_manager, IVirtualDesktopManager_iface);
+}
+
+static HRESULT WINAPI virtual_desktop_manager_QueryInterface(IVirtualDesktopManager *iface, REFIID iid,
+        void **out)
+{
+    if (!out) return E_POINTER;
+    *out = NULL;
+
+    if (IsEqualIID(iid, &IID_IUnknown) || IsEqualIID(iid, &IID_IVirtualDesktopManager))
+    {
+        *out = iface;
+        IUnknown_AddRef((IUnknown *)iface);
+        return S_OK;
+    }
+
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI virtual_desktop_manager_AddRef(IVirtualDesktopManager *iface)
+{
+    struct virtual_desktop_manager *manager = impl_from_IVirtualDesktopManager(iface);
+    return InterlockedIncrement(&manager->ref);
+}
+
+static ULONG WINAPI virtual_desktop_manager_Release(IVirtualDesktopManager *iface)
+{
+    struct virtual_desktop_manager *manager = impl_from_IVirtualDesktopManager(iface);
+    ULONG ref = InterlockedDecrement(&manager->ref);
+
+    if (!ref) free(manager);
+    return ref;
+}
+
+static HRESULT WINAPI virtual_desktop_manager_IsWindowOnCurrentVirtualDesktop(IVirtualDesktopManager *iface,
+        HWND window, BOOL *on_current_desktop)
+{
+    TRACE("iface %p, window %p, on_current_desktop %p.\n", iface, window, on_current_desktop);
+
+    if (!on_current_desktop) return E_POINTER;
+    *on_current_desktop = TRUE;
+    return S_OK;
+}
+
+static HRESULT WINAPI virtual_desktop_manager_GetWindowDesktopId(IVirtualDesktopManager *iface, HWND window,
+        GUID *desktop_id)
+{
+    TRACE("iface %p, window %p, desktop_id %p.\n", iface, window, desktop_id);
+
+    if (!desktop_id) return E_POINTER;
+    *desktop_id = GUID_NULL;
+    return S_OK;
+}
+
+static HRESULT WINAPI virtual_desktop_manager_MoveWindowToDesktop(IVirtualDesktopManager *iface, HWND window,
+        REFGUID desktop_id)
+{
+    TRACE("iface %p, window %p, desktop_id %s.\n", iface, window, debugstr_guid(desktop_id));
+    return desktop_id ? S_OK : E_INVALIDARG;
+}
+
+static const IVirtualDesktopManagerVtbl virtual_desktop_manager_vtbl =
+{
+    virtual_desktop_manager_QueryInterface,
+    virtual_desktop_manager_AddRef,
+    virtual_desktop_manager_Release,
+    virtual_desktop_manager_IsWindowOnCurrentVirtualDesktop,
+    virtual_desktop_manager_GetWindowDesktopId,
+    virtual_desktop_manager_MoveWindowToDesktop,
+};
+
+HRESULT WINAPI VirtualDesktopManager_Constructor(IUnknown *outer, REFIID iid, void **out)
+{
+    struct virtual_desktop_manager *manager;
+    HRESULT hr;
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (outer) return CLASS_E_NOAGGREGATION;
+
+    if (!(manager = calloc(1, sizeof(*manager)))) return E_OUTOFMEMORY;
+    manager->IVirtualDesktopManager_iface.lpVtbl = &virtual_desktop_manager_vtbl;
+    manager->ref = 1;
+
+    hr = virtual_desktop_manager_QueryInterface(&manager->IVirtualDesktopManager_iface, iid, out);
+    virtual_desktop_manager_Release(&manager->IVirtualDesktopManager_iface);
+    return hr;
+}
