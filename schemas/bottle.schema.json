{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compatforge.dev/schemas/bottle.schema.json",
  "title": "CompatForge Bottle Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "guest", "runtimePack", "storage", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "guest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["windowsVersion", "architecture"],
      "properties": {
        "windowsVersion": { "enum": ["win7", "win10", "win11"] },
        "architecture": { "enum": ["i386", "x86_64", "arm64"] }
      }
    },
    "runtimePack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "digest"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "version": { "type": "string" },
          "digest": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layoutVersion", "state"],
      "properties": {
        "layoutVersion": { "type": "integer", "minimum": 1 },
        "state": { "enum": ["ready", "preparing", "migrating", "repairing", "failed"] }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$" }
  }
}
