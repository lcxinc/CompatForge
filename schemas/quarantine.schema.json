{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compatforge.dev/schemas/quarantine.schema.json",
  "title": "CompatForge Mac-Win Migration Quarantine",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "records"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "records": {
      "type": "array",
      "maxItems": 90,
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!.*(?:^|/)\\.\\.?(?:/|$))[\\x20-\\x2E\\x30-\\x39\\x3B-\\x5B\\x5D-\\x7E]+(?:/[\\x20-\\x2E\\x30-\\x39\\x3B-\\x5B\\x5D-\\x7E]+)*$"
    },
    "commit": {
      "type": "string",
      "minLength": 40,
      "maxLength": 40,
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourcePath",
        "sourceCommit",
        "sourceSha256",
        "category",
        "status",
        "reason",
        "evidenceLocators",
        "intendedOwner",
        "releaseCondition"
      ],
      "properties": {
        "sourcePath": { "$ref": "#/$defs/relativePath" },
        "sourceCommit": { "$ref": "#/$defs/commit" },
        "sourceSha256": { "$ref": "#/$defs/sha256" },
        "category": {
          "enum": ["catalog", "patches", "probes", "fixtures", "bottle-schema"]
        },
        "status": { "const": "quarantined" },
        "reason": {
          "enum": [
            "absolute-path",
            "mutable-local-installation",
            "missing-digest",
            "unresolved-external-reference",
            "unresolved-environment-path",
            "missing-license",
            "missing-provenance",
            "unsupported-schema",
            "unsupported-behavior"
          ]
        },
        "evidenceLocators": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "intendedOwner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^compatforge/[a-z0-9][a-z0-9._-]*$"
        },
        "releaseCondition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    }
  }
}
