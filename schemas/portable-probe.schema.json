{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compatforge.dev/schemas/portable-probe.schema.json",
  "title": "CompatForge Portable Probe Asset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "source",
    "contentPath",
    "contentSha256",
    "mediaType",
    "executable",
    "referencedAssetIds",
    "intendedOwner",
    "license",
    "provenance"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "id": { "$ref": "#/$defs/id" },
    "kind": { "enum": ["shell", "registry", "source", "binary", "data", "other"] },
    "source": { "$ref": "#/$defs/sourceIdentity" },
    "contentPath": { "$ref": "#/$defs/relativePath" },
    "contentSha256": { "$ref": "#/$defs/sha256" },
    "mediaType": {
      "type": "string",
      "minLength": 3,
      "maxLength": 127,
      "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$"
    },
    "executable": { "const": false },
    "referencedAssetIds": {
      "type": "array",
      "maxItems": 90,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "intendedOwner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^compatforge/[a-z0-9][a-z0-9._-]*$"
    },
    "license": { "$ref": "#/$defs/reviewStatus" },
    "provenance": { "$ref": "#/$defs/reviewStatus" }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!.*(?:^|/)\\.\\.?(?:/|$))[\\x20-\\x2E\\x30-\\x39\\x3B-\\x5B\\x5D-\\x7E]+(?:/[\\x20-\\x2E\\x30-\\x39\\x3B-\\x5B\\x5D-\\x7E]+)*$"
    },
    "id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "commit": {
      "type": "string",
      "minLength": 40,
      "maxLength": 40,
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "reviewStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "const": "unresolved" }
      }
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRepository", "sourceCommit", "sourcePath", "sourceSha256"],
      "properties": {
        "sourceRepository": { "const": "a1112/Mac-Win" },
        "sourceCommit": { "$ref": "#/$defs/commit" },
        "sourcePath": { "$ref": "#/$defs/relativePath" },
        "sourceSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
