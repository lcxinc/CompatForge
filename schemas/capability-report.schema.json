{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compatforge.dev/schemas/capability-report.schema.json",
  "title": "CompatForge Host Capability Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "host", "runtimeProviders", "translators", "graphicsBackends"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "osVersion", "architecture"],
      "properties": {
        "os": { "enum": ["macos", "linux", "android", "windows"] },
        "osVersion": { "type": "string", "minLength": 1 },
        "architecture": { "enum": ["i386", "x86_64", "arm64"] },
        "kernel": { "type": "string" },
        "deviceModel": { "type": "string" }
      }
    },
    "runtimeProviders": {
      "type": "array",
      "items": { "$ref": "#/$defs/provider" },
      "uniqueItems": true
    },
    "translators": {
      "type": "array",
      "items": { "$ref": "#/$defs/provider" },
      "uniqueItems": true
    },
    "graphicsBackends": {
      "type": "array",
      "items": { "$ref": "#/$defs/provider" },
      "uniqueItems": true
    },
    "observations": {
      "type": "array",
      "items": { "$ref": "#/$defs/observation" },
      "uniqueItems": true
    },
    "features": {
      "type": "object",
      "additionalProperties": { "type": ["boolean", "string", "number"] }
    }
  },
  "$defs": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "version", "available"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
        "kind": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "available": { "type": "boolean" },
        "reason": { "type": "string" },
        "capabilities": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "status", "source"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
        "category": { "type": "string", "minLength": 1 },
        "status": { "enum": ["detected", "unavailable", "unknown"] },
        "source": {
          "enum": [
            "rust-standard-library",
            "operating-system-file",
            "operating-system-api",
            "built-in",
            "runtime-pack",
            "configuration"
          ]
        },
        "value": { "type": ["boolean", "string", "number"] },
        "reason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "detected" } } },
          "then": { "required": ["value"] }
        },
        {
          "if": { "properties": { "status": { "enum": ["unavailable", "unknown"] } } },
          "then": { "required": ["reason"] }
        }
      ]
    }
  }
}
