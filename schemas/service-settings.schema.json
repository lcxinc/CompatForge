{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compatforge.dev/schemas/service-settings.schema.json",
  "title": "CompatForge Service Settings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "automaticRuntimeDiscovery",
    "launchAtLogin",
    "closeToBackground",
    "defaultWindowsVersion",
    "defaultGuestArchitecture",
    "captureScreenshots",
    "retainDiagnosticsDays",
    "maximumParallelJobs",
    "automaticRollback",
    "reducedMotion",
    "compactApplicationGrid"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "automaticRuntimeDiscovery": { "type": "boolean" },
    "launchAtLogin": { "type": "boolean" },
    "closeToBackground": { "type": "boolean" },
    "defaultWindowsVersion": { "enum": ["windows7", "windows10", "windows11"] },
    "defaultGuestArchitecture": { "enum": ["i386", "x86_64"] },
    "captureScreenshots": { "type": "boolean" },
    "retainDiagnosticsDays": { "type": "integer", "minimum": 0, "maximum": 3650 },
    "maximumParallelJobs": { "type": "integer", "minimum": 1, "maximum": 16 },
    "automaticRollback": { "type": "boolean" },
    "reducedMotion": { "type": "boolean" },
    "compactApplicationGrid": { "type": "boolean" }
  }
}
