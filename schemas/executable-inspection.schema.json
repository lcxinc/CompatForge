{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compatforge.dev/schemas/executable-inspection.schema.json",
  "title": "CompatForge Executable Inspection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fileDigest", "fileSizeBytes", "format", "architecture", "machineCode", "imageKind", "subsystem", "subsystemCode", "entryPointRva", "sections", "importLibraries"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "fileDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "fileSizeBytes": { "type": "integer", "minimum": 64, "maximum": 67108864 },
    "format": { "enum": ["pe32", "pe32Plus"] },
    "architecture": { "enum": ["x86", "x86_64", "arm", "arm64"] },
    "machineCode": { "type": "integer", "minimum": 0, "maximum": 65535 },
    "imageKind": { "enum": ["executable", "dynamicLibrary"] },
    "subsystem": { "enum": ["unknown", "native", "windowsGui", "windowsConsole", "posixConsole", "nativeWindows", "efiApplication", "efiBootServiceDriver", "efiRuntimeDriver", "xbox", "windowsBootApplication"] },
    "subsystemCode": { "type": "integer", "minimum": 0, "maximum": 65535 },
    "entryPointRva": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 96,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "virtualAddress", "virtualSize", "rawDataSize", "readable", "writable", "executable"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 8, "pattern": "^[A-Za-z0-9.$_-]+$" },
          "virtualAddress": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
          "virtualSize": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
          "rawDataSize": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
          "readable": { "type": "boolean" },
          "writable": { "type": "boolean" },
          "executable": { "type": "boolean" }
        }
      }
    },
    "importLibraries": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 260, "pattern": "^[a-z0-9._-]+$" }
    }
  }
}
