{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compatforge.dev/schemas/guest-artifact.schema.json",
  "title": "CompatForge Guest Artifact Binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "digest",
    "sizeBytes",
    "storedPath",
    "originalName",
    "architecture",
    "imageKind",
    "subsystem",
    "inspectionSchemaVersion"
  ],
  "properties": {
    "digest": { "type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$" },
    "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 67108864 },
    "storedPath": { "type": "string", "minLength": 1 },
    "originalName": { "type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$" },
    "architecture": { "enum": ["i386", "x86_64"] },
    "imageKind": { "const": "executable" },
    "subsystem": { "enum": ["windowsConsole", "windowsGui"] },
    "inspectionSchemaVersion": { "const": "1" }
  }
}
