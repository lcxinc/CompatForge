{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compatforge.dev/schemas/macos-provider.schema.json",
  "title": "CompatForge macOS Provider Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runtimeStoreRoot", "wineRuntime"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "runtimeStoreRoot": { "$ref": "#/$defs/absolutePath" },
    "wineRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerId",
        "packId",
        "packDigest",
        "version",
        "architecture",
        "materializedRoot",
        "wine",
        "wineserver",
        "capabilities",
        "wined3dCapabilities"
      ],
      "properties": {
        "providerId": { "$ref": "#/$defs/id" },
        "packId": { "$ref": "#/$defs/id" },
        "packDigest": { "$ref": "#/$defs/digest" },
        "version": { "type": "string", "minLength": 1 },
        "architecture": { "enum": ["x86_64", "arm64"] },
        "materializedRoot": { "$ref": "#/$defs/absolutePath" },
        "wine": { "$ref": "#/$defs/entrypoint" },
        "wineserver": { "$ref": "#/$defs/entrypoint" },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["win32", "win64", "new-wow64", "guest-i386", "guest-x86_64"] }
        },
        "wined3dCapabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/graphicsCapability" }
        },
        "d3dmetal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["providerId", "version", "probeFile", "capabilities"],
          "properties": {
            "providerId": { "$ref": "#/$defs/id" },
            "version": { "type": "string", "minLength": 1 },
            "probeFile": { "$ref": "#/$defs/entrypoint" },
            "capabilities": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/graphicsCapability" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$" },
    "absolutePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:/|[A-Za-z]:[\\\\/]|\\\\\\\\).+"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[\\\\:])[^/]+(?:/[^/]+)*$"
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "graphicsCapability": {
      "enum": ["d3d8", "d3d9", "d3d10", "d3d11", "d3d12", "opengl", "metal"]
    }
  }
}
